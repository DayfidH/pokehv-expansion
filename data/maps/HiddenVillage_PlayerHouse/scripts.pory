mapscripts HiddenVillage_PlayerHouse_MapScripts {
}

script HiddenVillage_PlayerHouse_EventScript_PlayersDad {
    switch(var(VAR_HIDDEN_VILLAGE_STATE)) {
        case 0: 
            if (!flag(FLAG_RECEIVED_RUNNING_SHOES)) { 
                msgbox(format("Good morning {PLAYER}! I found these running shoes tucked away in a box in my bedroom... You can have them, they're your size!"))
                closemessage
                setflag(FLAG_RECEIVED_RUNNING_SHOES)
            } else {
                msgbox(format("You better be off or you'll be late... Good thing I gave you those running shoes!"))
                closemessage
            }
        default:
            buffernumberstring(STR_VAR_1, VAR_HIDDEN_VILLAGE_STATE) 
            msgbox(format("DEBUG_MISSING TEXT\nState ({STR_VAR_1})")) 
    }
}